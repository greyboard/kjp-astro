---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import Button from '../components/Button.astro';
import RingBadge from '../components/RingBadge.astro';
import ContactCard from '../components/ContactCard.astro';
import CtaBand from '../components/CtaBand.astro';
import { site } from '../data/site';

import heroImg from '../assets/img/hero-start.jpg';
import jugendlicheImg from '../assets/img/jugendliche.jpg';
import stegImg from '../assets/img/steg.jpg';
import einzelImg from '../assets/img/einzeltherapie.jpg';
import gruppeImg from '../assets/img/gruppentherapie.jpg';
import familieImg from '../assets/img/familientherapie.jpg';
import beratungImg from '../assets/img/beratung.jpg';
import elternImg from '../assets/img/elterngruppe.jpg';
import aerztImg from '../assets/img/aerztlich.jpg';
import lukasImg from '../assets/img/hero-adhs.jpg';
import sophieImg from '../assets/img/story-sophie.jpg';
import laraImg from '../assets/img/story-lara.jpg';
import emmaImg from '../assets/img/story-emma.jpg';

// Bis die übrigen Seiten gebaut sind, zeigen Links auf die Altseite (vor Go-Live umstellen)
const OLD = 'https://www.kinder-jugendpsychiater.org';

const audiences = [
  { title: 'Eltern', text: 'Ihr Kind wirkt unruhig, traurig oder ängstlich? Wir klären gemeinsam, was dahintersteckt.', href: '/kontakt#anmeldung', cta: 'Ersttermin anfragen' },
  { title: 'Jugendliche', text: 'Du musst da nicht alleine durch. Melde dich selbst, vertraulich und ohne Druck.', href: '/kontakt#jugendliche', cta: 'Lass uns mal reden' },
  { title: 'Zuweisende', text: 'Kinderärzte, Schulen, Kitas und Beratungsstellen: Wir stimmen Befunde und Schritte eng ab.', href: '/kontakt', cta: 'Kontakt zur Praxis' },
];

const conditions = [
  { label: 'ADHS / ADS', href: '/diagnose/adhs-ads', featured: true },
  { label: 'Depression und emotionale Störungen', href: `${OLD}/diagnose/emotionale-stoerung` },
  { label: 'Ängste', href: `${OLD}/diagnose/angststoerung` },
  { label: 'Legasthenie und Dyskalkulie', href: `${OLD}/diagnose/legasthenie-dyskalkulie` },
  { label: 'Psychosomatische Beschwerden', href: `${OLD}/diagnose` },
  { label: 'Kopfschmerzen und Migräne', href: `${OLD}/diagnose/kopfschmerzen/migraene` },
  { label: 'Borderline-Störung', href: `${OLD}/diagnose/borderline-stoerung` },
  { label: 'Traumata und Belastungsstörungen', href: `${OLD}/diagnose/belastungsstoerung` },
  { label: 'Einnässen und Einkoten', href: `${OLD}/diagnose/einnaessen-einkoten` },
  { label: 'Störungen des Sozialverhaltens', href: `${OLD}/diagnose/stoerungen-des-sozialverhaltens` },
];

const therapies = [
  { title: 'Einzeltherapie', text: 'Ein geschützter Raum, in dem Ihr Kind in seinem Tempo an seinen Themen arbeitet.', img: einzelImg, href: `${OLD}/therapie/einzeltherapie`, span: 'md:col-span-2 md:row-span-2' },
  { title: 'Gruppentherapie', text: 'Mit Gleichaltrigen soziale Fähigkeiten und Konzentration üben.', img: gruppeImg, href: `${OLD}/therapie/gruppentherapie`, span: '' },
  { title: 'Familientherapie', text: 'Gemeinsam neue Wege im Miteinander finden.', img: familieImg, href: `${OLD}/therapie/familientherapie`, span: '' },
  { title: 'Beratung', text: 'Orientierung für Eltern, Lehrkräfte und Bezugspersonen.', img: beratungImg, href: `${OLD}/therapie/beratung`, span: '' },
  { title: 'Elterngruppe', text: 'Austausch und konkrete Strategien für den Familienalltag.', img: elternImg, href: `${OLD}/therapie/elterngruppe`, span: '' },
  { title: 'Ärztliche Behandlung', text: 'Fachärztliche Begleitung und, wenn nötig, sorgfältig kontrollierte Medikation.', img: aerztImg, href: `${OLD}/therapie/medikation`, span: 'md:col-span-4' },
];

const steps = [
  { title: 'Anmeldung', text: 'Sie melden Ihr Kind telefonisch oder über das Formular an und erhalten die Unterlagen zum Ersttermin.' },
  { title: 'Ersttermin', text: 'Wir lernen Ihr Kind und Ihre Familie kennen, erheben die Vorgeschichte und sichten vorhandene Befunde.' },
  { title: 'Diagnostik', text: 'Testdiagnostik, Verhaltensbeobachtung und körperliche Untersuchung, danach eine Besprechung im Team.' },
  { title: 'Therapieplan', text: 'Im gemeinsamen Gespräch legen wir fest, welche Unterstützung passt. Sie erhalten einen schriftlichen Bericht.' },
];

const stories = [
  { name: 'Lukas', title: 'Wenn Energie ihren Platz sucht', img: lukasImg, href: `${OLD}/fallbeispiele/lukas-wenn-energie-ihren-platz-sucht` },
  { name: 'Sophie', title: 'Mut zur Trennung', img: sophieImg, href: `${OLD}/fallbeispiele/sophie-mut-zur-trennung` },
  { name: 'Lara', title: 'Buchstaben und Mut', img: laraImg, href: `${OLD}/fallbeispiele/lara-buchstaben-und-mut` },
  { name: 'Emma', title: 'Die Kraft der Fantasie', img: emmaImg, href: `${OLD}/fallbeispiele/emma-die-kraft-der-fantasie` },
];
---
<BaseLayout
  title="Kinder- und Jugendpsychiater Regensburg | Praxis Estrada Aguila & Dr. Islinger"
  description="Kinder- und Jugendpsychiater in Regensburg mit interdisziplinärem Team. Diagnostik, Therapie und Beratung für Kinder, Jugendliche und Familien. Tel. 0941 640 82 80"
>
  <Hero image={heroImg} eyebrow={`Sozialpsychiatrische Praxis seit ${site.since}`} position="70% center">
    <h1 class="mt-6 max-w-5xl animate-rise text-[clamp(2.75rem,8vw,7.5rem)] text-white [animation-delay:120ms]">
      Ihr Kinder- und Jugend&shy;psychiater <span class="accent text-orange">in Regensburg</span>
    </h1>
    <div class="mt-10 grid animate-rise gap-10 [animation-delay:260ms] lg:grid-cols-[1fr_auto] lg:items-end">
      <div>
        <p class="max-w-xl text-lg text-white/85 sm:text-xl">
          <span class="accent text-2xl text-white sm:text-3xl">Willkommen auf dem Weg der Begegnung.</span><br />
          Ein erfahrener Kinder- und Jugendpsychiater und sein Team begleiten Kinder, Jugendliche und Familien mit Diagnostik, Therapie und Beratung.
        </p>
        <div class="mt-8 flex flex-wrap gap-3">
          <Button href="/kontakt#anmeldung">Ersttermin anfragen</Button>
          <Button href={site.phone.href} variant="light">{site.phone.display}</Button>
        </div>
      </div>
      <div class="hidden items-center gap-5 rounded-3xl bg-white/10 p-5 ring-1 ring-white/20 backdrop-blur-xl lg:flex">
        <RingBadge text="Kinder · Jugendliche · Familien · " class="size-24 text-white" />
        <div class="text-sm">
          <p class="font-semibold text-white">Telefonisch erreichbar</p>
          <p class="text-white/75">Mo bis Fr, 9 bis 12 Uhr</p>
          <p class="mt-2 text-white/75">{site.address.street}, {site.address.city}</p>
        </div>
      </div>
    </div>
    <a href="#begegnung" class="mt-14 hidden w-fit items-center gap-3 text-xs font-semibold uppercase tracking-[0.22em] text-white/70 no-underline hover:text-white sm:flex">
      <span class="relative h-10 w-6 rounded-full ring-1 ring-white/50"><span class="absolute left-1/2 top-2 h-2 w-1 -translate-x-1/2 animate-bounce rounded-full bg-white"></span></span>
      Mehr erfahren
    </a>
  </Hero>

  <!-- Statement + Zielgruppen -->
  <section id="begegnung" class="container-page py-24 sm:py-36" aria-labelledby="statement">
    <div class="grid gap-16 lg:grid-cols-[1.25fr_0.75fr] lg:items-center">
      <div data-reveal>
        <p class="eyebrow">Ein Ort des Verstehens</p>
        <h2 id="statement" class="mt-6 text-[clamp(2rem,4.6vw,4.25rem)]">
          Jedes Kind erzählt seine eigene Geschichte. <span class="accent text-orange-deep">Manchmal laut, manchmal leise.</span>
        </h2>
        <p class="mt-8 max-w-2xl text-lg text-muted">
          Wir hören zu, beobachten, fühlen mit und versuchen, das Gesagte und das Ungesagte zu verstehen.
          Ärztinnen und Ärzte, Psychologinnen, Pädagogen und Therapeutinnen denken bei uns gemeinsam weiter.
          Oft beginnt Veränderung schon dort, wo wir einander wirklich verstehen.
        </p>
      </div>
      <div class="relative hidden h-[34rem] lg:block" data-reveal style="--d:150ms">
        <Image src={jugendlicheImg} alt="Jugendlicher sitzt nachdenklich auf einer Treppe" widths={[400, 800]} sizes="26rem" class="absolute right-0 top-0 h-[26rem] w-[19rem] rounded-[2rem] object-cover shadow-2xl" />
        <Image src={stegImg} alt="Junge sitzt auf einem Steg am Wasser" widths={[400, 800]} sizes="18rem" class="absolute bottom-0 left-0 h-60 w-72 rounded-[2rem] object-cover ring-8 ring-ground" />
        <div class="absolute -right-4 bottom-40 rounded-full bg-ground p-2 shadow-xl"><RingBadge text={`Seit ${site.since} · Regensburg · `} class="size-28 text-heading" /></div>
      </div>
    </div>

    <ul class="mt-20 grid gap-5 md:grid-cols-3">
      {audiences.map((a, i) => (
        <li data-reveal style={`--d:${i * 100}ms`}>
          <a href={a.href} class="group relative flex h-full flex-col overflow-hidden rounded-[var(--radius-card)] bg-surface p-8 no-underline shadow-[0_1px_0_#e5d9cc] ring-1 ring-line transition duration-300 hover:-translate-y-1 hover:shadow-xl sm:p-10">
            <span class="absolute inset-x-0 top-0 h-1.5" style={`background:${['#F07F12', '#ACC90B', '#4C423A'][i]}`} aria-hidden="true"></span>
            <span class="font-serif text-3xl leading-none text-orange-dark">Für</span>
            <span class="mt-1 text-3xl font-medium text-heading">{a.title}</span>
            <span class="mt-4 text-muted">{a.text}</span>
            <span class="mt-8 inline-flex items-center gap-3 font-semibold text-heading">
              {a.cta}
              <span class="grid size-9 place-items-center rounded-full transition duration-300 group-hover:translate-x-1" style={`background:${['#F07F12', '#ACC90B', '#4C423A'][i]};color:${['#2A231E', '#2A231E', '#FFFFFF'][i]}`} aria-hidden="true">→</span>
            </span>
          </a>
        </li>
      ))}
    </ul>
  </section>

  <!-- Krankheitsbilder -->
  <section class="grain relative overflow-hidden bg-night py-24 text-white sm:py-32" aria-labelledby="krankheitsbilder">
    <div class="pointer-events-none absolute -right-40 -top-40 size-[36rem] rounded-full bg-orange/25 blur-3xl" aria-hidden="true"></div>
    <div class="pointer-events-none absolute -bottom-60 -left-40 size-[32rem] rounded-full bg-leaf/15 blur-3xl" aria-hidden="true"></div>
    <div class="container-page relative">
      <div class="flex flex-wrap items-end justify-between gap-8" data-reveal>
        <div>
          <p class="eyebrow eyebrow-light">Diagnose</p>
          <h2 id="krankheitsbilder" class="mt-6 text-[clamp(2.25rem,5vw,4.5rem)] text-white">Wobei wir <span class="accent text-orange">helfen</span></h2>
        </div>
        <p class="max-w-md text-white/70">Diese Themen begegnen uns im Praxisalltag besonders häufig. Am Anfang steht immer eine sorgfältige Abklärung.</p>
      </div>
      <ol class="mt-16 grid border-t border-white/15 md:grid-cols-2 md:gap-x-16">
        {conditions.map((c, i) => (
          <li class="border-b border-white/15" data-reveal style={`--d:${(i % 2) * 80}ms`}>
            <a href={c.href} class="group flex items-center gap-6 py-6 text-white no-underline">
              <span class="w-8 text-sm tabular-nums text-white/40">{String(i + 1).padStart(2, '0')}</span>
              <span class:list={['flex-1 text-xl font-medium tracking-tight transition duration-300 group-hover:translate-x-2 sm:text-2xl', c.featured && 'text-orange']}>{c.label}</span>
              <span class="grid size-10 shrink-0 place-items-center rounded-full ring-1 ring-white/25 transition duration-300 group-hover:bg-orange group-hover:text-night group-hover:ring-orange" aria-hidden="true">→</span>
            </a>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- Therapie Bento -->
  <section class="container-page py-24 sm:py-32" aria-labelledby="therapie">
    <div class="grid gap-8 lg:grid-cols-2 lg:items-end" data-reveal>
      <div>
        <p class="eyebrow">Therapie</p>
        <h2 id="therapie" class="mt-6 text-[clamp(2.25rem,5vw,4.5rem)]">Körper und Seele <span class="accent text-orange-deep">sind eine Einheit</span></h2>
      </div>
      <p class="max-w-lg text-lg text-muted lg:justify-self-end">Wir verbinden ärztliche, psychologische und pädagogische Angebote zu einem Plan, der zu Ihrem Kind passt.</p>
    </div>
    <div class="mt-14 grid auto-rows-[18rem] gap-4 md:grid-cols-4">
      {therapies.map((t, i) => (
        <a href={t.href} class:list={['group relative isolate flex flex-col justify-end overflow-hidden rounded-[var(--radius-card)] bg-night p-7 text-white no-underline', t.span]} data-reveal style={`--d:${(i % 3) * 90}ms`}>
          <Image src={t.img} alt="" widths={[480, 960]} sizes="(min-width: 768px) 50vw, 100vw" class="absolute inset-0 -z-10 size-full object-cover opacity-85 transition duration-700 group-hover:scale-105" />
          <div class="absolute inset-0 -z-10 bg-gradient-to-t from-night via-night/40 to-transparent"></div>
          <h3 class="text-2xl text-white sm:text-3xl">{t.title}</h3>
          <p class="mt-2 max-w-sm text-sm text-white/80">{t.text}</p>
          <span class="absolute right-5 top-5 grid size-11 place-items-center rounded-full bg-white/15 ring-1 ring-white/30 backdrop-blur transition duration-300 group-hover:bg-orange group-hover:text-night" aria-hidden="true">↗</span>
        </a>
      ))}
    </div>
  </section>

  <!-- Ablauf -->
  <section class="bg-sand py-24 sm:py-32" aria-labelledby="ablauf">
    <div class="container-page grid gap-14 lg:grid-cols-[0.8fr_1.2fr]">
      <div class="lg:sticky lg:top-28 lg:self-start" data-reveal>
        <p class="eyebrow">Ablauf</p>
        <h2 id="ablauf" class="mt-6 text-[clamp(2.25rem,5vw,4.5rem)]">So läuft es <span class="accent text-orange-deep">bei uns ab</span></h2>
        <p class="mt-6 max-w-md text-lg text-muted">Vom ersten Anruf bis zum Therapieplan begleiten wir Sie Schritt für Schritt.</p>
        <div class="mt-8"><Button href="/kontakt#download" variant="outline">Unterlagen herunterladen</Button></div>
      </div>
      <ol class="space-y-4">
        {steps.map((s, i) => (
          <li class="grid gap-6 rounded-[var(--radius-card)] bg-surface p-8 sm:grid-cols-[auto_1fr] sm:p-10" data-reveal style={`--d:${i * 80}ms`}>
            <span class="accent text-7xl leading-none text-orange" aria-hidden="true">{i + 1}</span>
            <div>
              <h3 class="text-2xl sm:text-3xl">{s.title}</h3>
              <p class="mt-3 text-muted">{s.text}</p>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- Kompetenz -->
  <section class="container-page py-24 sm:py-32" aria-labelledby="kompetenz">
    <div class="grid gap-14 lg:grid-cols-2">
      <div data-reveal>
        <p class="eyebrow">Unser Team</p>
        <h2 id="kompetenz" class="mt-6 text-[clamp(2.25rem,5vw,4.5rem)]">Kompetenz <span class="accent text-orange-deep">im Miteinander</span></h2>
        <div class="prose-kjp mt-8 text-lg text-muted">
          <p>Unser Kinder- und Jugendpsychiater arbeitet mit Psychologinnen, Pädagogen und weiteren therapeutischen Berufsgruppen Hand in Hand. So entsteht ein sozialpsychiatrisches Zentrum, das Kinder, Jugendliche und Eltern umfassend begleitet.</p>
          <p>Wir stehen in engem Austausch mit Haus- und Fachärzten, Ergo- und Physiotherapeuten, Schulen, Kindergärten, Frühförderstellen und Beratungsstellen. Grundlage ist immer das Wohl des Kindes.</p>
        </div>
      </div>
      <dl class="grid grid-cols-2 gap-4 self-end">
        <div class="col-span-2 rounded-[var(--radius-card)] bg-orange p-8 text-night" data-reveal>
          <dt class="text-sm font-semibold uppercase tracking-[0.22em]">Für Familien da seit</dt>
          <dd class="mt-2 text-[clamp(4.5rem,10vw,8rem)] font-semibold leading-none tracking-[-0.05em]">{site.since}</dd>
        </div>
        <div class="flex flex-col-reverse justify-end rounded-[var(--radius-card)] bg-leaf p-8 text-night" data-reveal style="--d:100ms">
          <dt class="mt-2 text-sm font-medium">Team aus Ärzten, Psychologen und Pädagogen</dt>
          <dd class="text-6xl font-semibold tracking-[-0.05em]">1</dd>
        </div>
        <div class="flex flex-col-reverse justify-end rounded-[var(--radius-card)] bg-heading p-8 text-white" data-reveal style="--d:200ms">
          <dt class="mt-2 text-sm font-medium">Therapieangebote unter einem Dach</dt>
          <dd class="text-6xl font-semibold tracking-[-0.05em]">6</dd>
        </div>
      </dl>
    </div>
  </section>

  <!-- Aus der Praxis -->
  <section class="pb-24 sm:pb-32" aria-labelledby="praxis">
    <div class="container-page flex flex-wrap items-end justify-between gap-6" data-reveal>
      <div>
        <p class="eyebrow">Aus der Praxis</p>
        <h2 id="praxis" class="mt-6 text-[clamp(2.25rem,5vw,4.5rem)]">Geschichten von <span class="accent text-orange-deep">Entwicklung und Wandel</span></h2>
      </div>
      <p class="max-w-sm text-sm text-muted">Namen und Details sind verändert. Die Geschichten stehen für typische Erfahrungen vieler Familien.</p>
    </div>
    <ul class="container-page mt-12 flex snap-x snap-mandatory gap-4 overflow-x-auto pb-4 [scrollbar-width:thin]">
      {stories.map((s, i) => (
        <li class="w-[78%] shrink-0 snap-start sm:w-[46%] lg:w-[calc(25%-0.75rem)]" data-reveal style={`--d:${i * 90}ms`}>
          <a href={s.href} class="group block text-heading no-underline">
            <div class="aspect-[4/5] overflow-hidden rounded-[var(--radius-card)]">
              <Image src={s.img} alt="" widths={[400, 800]} sizes="(min-width: 1024px) 25vw, 78vw" class="size-full object-cover transition duration-700 group-hover:scale-105" />
            </div>
            <p class="mt-5 text-sm font-semibold text-orange-deep">{s.name}</p>
            <h3 class="mt-1 text-2xl">{s.title}</h3>
          </a>
        </li>
      ))}
    </ul>
  </section>

  <CtaBand />

  <section class="container-page py-24" aria-labelledby="kontakt-start">
    <div class="flex flex-wrap items-end justify-between gap-6" data-reveal>
      <h2 id="kontakt-start" class="text-[clamp(2rem,4vw,3.5rem)]">Praxis <span class="accent text-orange-deep">in Regensburg</span></h2>
      <a href="/kontakt#anfahrt" class="font-semibold">Anfahrt und Parken →</a>
    </div>
    <ContactCard class="mt-10" />
  </section>
</BaseLayout>
