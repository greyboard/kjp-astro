---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import ContactCard from '../components/ContactCard.astro';
import GhlEmbed from '../components/GhlEmbed.astro';
import Hero from '../components/Hero.astro';
import Button from '../components/Button.astro';
import heroImg from '../assets/img/hero-kontakt.jpg';
import { site } from '../data/site';

const topics = [
  { id: 'anmeldung', label: 'Erstanmeldung', text: 'Ihr Kind war noch nicht bei uns' },
  { id: 'erstsichtung', label: 'Erstsichtung buchen', text: 'Termin direkt online wählen' },
  { id: 'rezept', label: 'Rezept vorbestellen', text: 'Nur für Patienten in Behandlung' },
  { id: 'jugendliche', label: 'Für Jugendliche', text: 'Du willst dich selbst melden' },
  { id: 'download', label: 'Unterlagen', text: 'Fragebögen und Vertrag' },
  { id: 'anfahrt', label: 'Anfahrt', text: 'Auto, Bus und Bahn' },
];
---
<BaseLayout
  title="Kontakt und Anmeldung | Kinder- und Jugendpsychiater Regensburg"
  description="Kontakt zum Kinder- und Jugendpsychiater in Regensburg: Erstanmeldung, Termin zur Erstsichtung, Rezeptvorbestellung und Unterlagen. Tel. 0941 640 82 80"
>
  <Hero image={heroImg} size="tall" alt="Jugendliche im Gespräch in einem hellen Raum" position="center 40%">
    <div class="animate-rise"><Breadcrumbs items={[{ label: 'Start', href: '/' }, { label: 'Kontakt' }]} light /></div>
    <h1 class="mt-6 max-w-4xl animate-rise text-[clamp(2.75rem,7vw,6.5rem)] text-white [animation-delay:120ms]">Kontakt <span class="accent text-amber">und Anmeldung</span></h1>
    <div class="mt-8 grid animate-rise gap-8 [animation-delay:240ms] lg:grid-cols-[1fr_auto] lg:items-end">
      <p class="max-w-xl text-lg text-white/85">Schön, dass Sie den ersten Schritt gehen. Am schnellsten erreichen Sie uns telefonisch, für eine Erstanmeldung können Sie auch unser Formular nutzen.</p>
      <div class="flex flex-wrap gap-3">
        <Button href={site.phone.href} variant="light">{site.phone.display}</Button>
        <Button href="#anmeldung">Zur Anmeldung</Button>
      </div>
    </div>
  </Hero>

  <section class="container-page -mt-10 relative z-10" aria-label="Kontaktdaten">
    <ContactCard class="shadow-2xl shadow-night/10" />
    <div class="mt-6 flex flex-col gap-3 rounded-[var(--radius-card)] bg-night p-6 text-white sm:flex-row sm:items-center sm:gap-6 sm:p-7" role="note">
      <span class="grid size-12 shrink-0 place-items-center rounded-full bg-orange text-xl font-bold text-night" aria-hidden="true">!</span>
      <p class="text-sm text-white/80"><strong class="text-white">In einer akuten Krise?</strong> Unsere Formulare ersetzen keine Notfallversorgung. Bei akuter Gefahr: Notruf <a href="tel:112" class="font-bold text-amber">112</a>. Außerhalb der Sprechzeiten: ärztlicher Bereitschaftsdienst <a href="tel:116117" class="font-bold text-amber">116 117</a>. Kinder und Jugendliche: Nummer gegen Kummer <a href="tel:116111" class="font-bold text-amber">116 111</a>.</p>
    </div>
  </section>

  <!-- Anliegen-Navigation, funktioniert ohne JavaScript über Anker -->
  <nav aria-label="Anliegen wählen" class="container-page mt-24">
    <p class="eyebrow">Ihr Anliegen</p>
    <h2 class="mt-5 text-[clamp(2rem,4.5vw,4rem)]">Worum <span class="accent text-orange-deep">geht es?</span></h2>
    <ul class="mt-6 grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
      {topics.map((t) => (
        <li>
          <a href={`#${t.id}`} class="group flex h-full items-center justify-between gap-4 rounded-[var(--radius-card)] border border-line bg-surface px-6 py-5 text-heading no-underline transition duration-300 hover:-translate-y-0.5 hover:border-ink hover:bg-ink hover:text-ground">
            <span><span class="block text-xl font-semibold tracking-tight">{t.label}</span><span class="text-sm text-muted transition group-hover:text-ground/70">{t.text}</span></span>
            <span class="grid size-10 shrink-0 place-items-center rounded-full bg-sand text-night transition group-hover:bg-orange" aria-hidden="true">↓</span>
          </a>
        </li>
      ))}
    </ul>
  </nav>

  <div class="container-page mt-24 space-y-28">
    <!-- Erstanmeldung -->
    <section id="anmeldung" aria-labelledby="h-anmeldung" class="grid gap-8 lg:grid-cols-[0.8fr_1.2fr]">
      <div>
        <p class="eyebrow">Neu bei uns</p>
        <h2 id="h-anmeldung" class="mt-5 text-[clamp(2rem,4vw,3.25rem)]">Erstanmeldung</h2>
        <div class="prose-kjp mt-4 text-muted">
          <p>Ihr Kind war noch nicht bei uns in Behandlung? Dann schicken Sie uns gern eine kurze Anfrage. Wir melden uns, um alles Weitere mit Ihnen abzustimmen.</p>
          <ul>
            <li>Name und Geburtsdatum Ihres Kindes</li>
            <li>Ihre Telefonnummer und wann Sie gut erreichbar sind</li>
            <li>In ein, zwei Sätzen, worum es geht</li>
          </ul>
          <p class="text-sm">Bitte schreiben Sie keine ausführlichen Befunde oder Diagnosen ins Formular. Das besprechen wir persönlich.</p>
        </div>
      </div>
      <GhlEmbed type="form" id={site.ghl.formAnmeldung} title="Kontaktformular zur Erstanmeldung" />
    </section>

    <!-- Erstsichtung -->
    <section id="erstsichtung" aria-labelledby="h-erstsichtung" class="grid gap-8 lg:grid-cols-[0.8fr_1.2fr]">
      <div>
        <p class="eyebrow">Online buchen</p>
        <h2 id="h-erstsichtung" class="mt-5 text-[clamp(2rem,4vw,3.25rem)]">Termin zur Erstsichtung</h2>
        <p class="mt-4 text-muted">Wählen Sie im Kalender einen freien Termin für die Erstsichtung. Sie erhalten anschließend eine Bestätigung per E-Mail.</p>
      </div>
      <GhlEmbed type="booking" id={site.ghl.booking} title="Online-Terminbuchung zur Erstsichtung" />
    </section>

    <!-- Rezept -->
    <section id="rezept" aria-labelledby="h-rezept" class="grid gap-8 rounded-[2rem] bg-sand p-8 sm:p-12 lg:grid-cols-[0.8fr_1.2fr]">
      <div>
        <p class="eyebrow">Für Patienten in Behandlung</p>
        <h2 id="h-rezept" class="mt-5 text-[clamp(2rem,4vw,3.25rem)]">Rezept vorbestellen</h2>
      </div>
      <div class="prose-kjp">
        <p>Vorbestellen können Sie nur Wiederholungsrezepte für Medikamente, die wir als Dauertherapie verordnet haben. Voraussetzung ist, dass wir Sie und Ihr Kind regelmäßig in unserer Sprechstunde sehen.</p>
        <p>Ergotherapie- und Logopädierezepte sind nur im Rahmen einer von uns eingeleiteten Mitbehandlung möglich. Alle Rezepte werden ärztlich geprüft. Bitte bringen Sie zur Abholung die Versichertenkarte mit.</p>
        <p><strong>So bestellen Sie:</strong> telefonisch unter <a href={site.phone.href}>{site.phone.display}</a> ({site.phoneHours}) oder per E-Mail an <a href={`mailto:${site.email}?subject=Rezeptvorbestellung`}>{site.email}</a> mit Name, Geburtsdatum und Medikament.</p>
      </div>
    </section>

    <!-- Jugendliche -->
    <section id="jugendliche" aria-labelledby="h-jugendliche" class="grid gap-8 lg:grid-cols-[0.8fr_1.2fr]">
      <div>
        <p class="eyebrow">Für Jugendliche</p>
        <h2 id="h-jugendliche" class="mt-5 text-[clamp(2rem,4vw,3.25rem)]">Lass uns mal reden</h2>
        <div class="prose-kjp mt-4 text-muted">
          <p>Vielleicht fühlst du dich oft gestresst, traurig, wütend oder einfach überfordert. Bei uns kannst du dich melden, ohne Druck und ohne Erwartungen. Du entscheidest selbst, was du erzählen willst und wie viel.</p>
          <p>Damit wir dir antworten können, brauchen wir deinen richtigen Namen und deine Kontaktdaten. Wenn du unter 18 bist, brauchen wir für weitere Gespräche in der Regel das Einverständnis deiner Eltern. Für deine erste Anfrage noch nicht.</p>
          <p>Bitte schick uns keine medizinischen Unterlagen oder Fotos. Schreib nur kurz, worum es geht.</p>
        </div>
        <p class="mt-6 rounded-2xl bg-sand p-4 text-sm"><strong>Hinweis für Eltern:</strong> Dieser Bereich richtet sich an Jugendliche, die selbst Kontakt aufnehmen möchten. Für reguläre Ersttermine nutzen Sie bitte die <a href="#anmeldung">Erstanmeldung</a>.</p>
      </div>
      <GhlEmbed type="form" id={site.ghl.formJugendliche} title="Kontaktformular für Jugendliche" />
    </section>

    <!-- Downloads -->
    <section id="download" aria-labelledby="h-download">
      <p class="eyebrow">Unterlagen</p>
      <h2 id="h-download" class="mt-5 text-[clamp(2rem,4vw,3.25rem)]">Unterlagen zum Ersttermin</h2>
      <p class="mt-4 max-w-2xl text-muted">Bitte bringen Sie die ausgefüllten Fragebögen und den unterschriebenen Behandlungsvertrag zum ersten Termin mit.</p>
      <ul class="mt-8 grid gap-4 sm:grid-cols-3">
        {site.downloads.map((d) => (
          <li>
            <a href={d.href} target="_blank" rel="noopener" class="flex items-center gap-4 rounded-2xl border border-line bg-surface p-5 text-heading no-underline transition hover:border-orange hover:shadow-md">
              <span class="grid size-12 shrink-0 place-items-center rounded-xl bg-cream text-xs font-bold text-orange-deep" aria-hidden="true">PDF</span>
              <span><span class="block font-bold">{d.label}</span><span class="text-sm text-muted">PDF, {d.size}</span></span>
            </a>
          </li>
        ))}
      </ul>
    </section>

    <!-- Anfahrt -->
    <section id="anfahrt" aria-labelledby="h-anfahrt">
      <p class="eyebrow">Anfahrt</p>
      <h2 id="h-anfahrt" class="mt-5 text-[clamp(2rem,4vw,3.25rem)]">Ihr Weg zu unserer Praxis</h2>
      <p class="mt-4 text-muted">{site.address.street}, {site.address.zip} {site.address.city} · <a href={site.mapsUrl} target="_blank" rel="noopener">Route in Google Maps öffnen</a></p>
      <div class="mt-8 grid gap-5 md:grid-cols-3">
        <article class="card" data-reveal>
          <h3 class="text-xl">Mit Bus und Bahn</h3>
          <p class="mt-3 text-muted">Von der Haltestelle Albertstraße bzw. vom Hauptbahnhof circa 5 Minuten zu Fuß: links in die Dr.-Martin-Luther-Straße, geradeaus bis zur zweiten Kreuzung, rechts in die Landshuter Straße. Das Haus liegt nach etwa 40 Metern links.</p>
        </article>
        <article class="card" data-reveal>
          <h3 class="text-xl">Ausfahrt Königswiesen</h3>
          <p class="mt-3 text-muted">Rechts Richtung Innenstadt (Kirchmeierstraße). Nach den Arcaden links über die Brücke, an der nächsten Ampel rechts in die Luitpoldstraße, links in die Roritzerstraße und links in die Landshuter Straße. Nach etwa 50 Metern rechts.</p>
        </article>
        <article class="card" data-reveal>
          <h3 class="text-xl">Ausfahrt Burgweinting</h3>
          <p class="mt-3 text-muted">Links Richtung Innenstadt, am Stobäusplatz links Richtung Zentrum einordnen und auf der Landshuter Straße bleiben. Nach etwa 150 Metern rechts.</p>
        </article>
      </div>
      <p class="mt-6 rounded-2xl bg-sand p-5 text-sm"><strong>Parken:</strong> im Hof oder auf dem Parkstreifen vor der Praxis. Alternativ in den Parkhäusern am Dachauplatz oder Castra Regina in Bahnhofsnähe.</p>
    </section>
  </div>
</BaseLayout>
