---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Datenschutzerklärung" description="Datenschutzerklärung der Praxis für Kinder- und Jugendpsychiatrie in Regensburg." noindex>
  <section class="container-page max-w-3xl pt-14">
    <h1 class="text-4xl">Datenschutzerklärung</h1>
    <p class="mt-6 rounded-2xl border-2 border-orange bg-cream p-5 text-sm">
      <strong>Platzhalter:</strong> Die Datenschutzerklärung wird vor dem Go-Live von der Praxis bzw. deren
      Rechtsberatung geliefert. Sie muss u. a. Cloudflare (Hosting) und LeadConnector/HighLevel (Formulare,
      Terminbuchung) als Auftragsverarbeiter nennen.
    </p>
  </section>
</BaseLayout>
