---
// 2-Klick-Lösung: GHL (LeadConnector) lädt erst nach aktiver Zustimmung.
interface Props {
  type: 'form' | 'booking';
  id: string;
  title: string;
  height?: number;
}
const { type, id, title, height = type === 'booking' ? 900 : 720 } = Astro.props;
const src = `https://api.leadconnectorhq.com/widget/${type}/${id}`;
---
<div class="ghl-embed rounded-[var(--radius-card)] border border-line bg-surface" data-src={src} data-id={id} data-type={type} data-title={title} data-height={height}>
  <div class="ghl-placeholder flex flex-col items-start gap-4 p-6 sm:p-8">
    <p class="font-semibold">{title}</p>
    <p class="text-sm text-muted">
      Das Formular wird von unserem Dienstleister LeadConnector (HighLevel) bereitgestellt. Mit dem Klick auf
      „Formular laden“ werden Daten an diesen Anbieter übertragen. Details in der
      <a href="/datenschutzerklaerung">Datenschutzerklärung</a>.
    </p>
    <button type="button" class="ghl-load inline-flex min-h-12 items-center rounded-full bg-orange px-6 py-3 font-bold text-night transition hover:bg-orange-light">
      {type === 'booking' ? 'Terminkalender laden' : 'Formular laden'}
    </button>
    <noscript><p class="text-sm">Bitte aktivieren Sie JavaScript oder rufen Sie uns an.</p></noscript>
  </div>
</div>

<script>
  const SCRIPT = 'https://link.msgsndr.com/js/form_embed.js';
  function loadScript() {
    if (document.querySelector(`script[src="${SCRIPT}"]`)) return;
    const s = document.createElement('script');
    s.src = SCRIPT;
    s.async = true;
    document.body.appendChild(s);
  }
  document.querySelectorAll<HTMLElement>('.ghl-embed').forEach((box) => {
    box.querySelector('.ghl-load')?.addEventListener('click', () => {
      const { src, id, type, title, height } = box.dataset;
      const iframe = document.createElement('iframe');
      iframe.src = src!;
      iframe.title = title!;
      iframe.id = `${type === 'booking' ? 'booking' : 'inline'}-${id}`;
      iframe.style.cssText = `width:100%;height:${height}px;border:none;border-radius:1.5rem;overflow:hidden`;
      iframe.setAttribute('scrolling', 'no');
      box.replaceChildren(iframe);
      loadScript();
    });
  });
</script>
