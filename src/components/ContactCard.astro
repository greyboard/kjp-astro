---
import { site } from '../data/site';
interface Props { class?: string; headingLevel?: 'h2' | 'h3' }
const { class: cls = '', headingLevel: H = 'h3' } = Astro.props;
---
<div class:list={['grid gap-px overflow-hidden rounded-[var(--radius-card)] bg-line ring-1 ring-line sm:grid-cols-3', cls]}>
  <div class="bg-surface p-7">
    <H class="text-xs font-semibold uppercase tracking-[0.22em] text-orange-deep">Telefon</H>
    <a href={site.phone.href} class="mt-3 block text-3xl font-semibold tracking-tight text-heading no-underline">{site.phone.display}</a>
    <p class="mt-2 text-sm text-muted">{site.phoneHours}</p>
    <a href={`mailto:${site.email}`} class="mt-4 block break-all text-sm">{site.email}</a>
  </div>
  <div class="bg-surface p-7">
    <H class="text-xs font-semibold uppercase tracking-[0.22em] text-orange-deep">Praxiszeiten</H>
    <dl class="mt-3 space-y-3">
      {site.openingHours.map((h) => (
        <div><dt class="text-sm text-muted">{h.label}</dt><dd class="text-lg font-semibold">{h.time}</dd></div>
      ))}
    </dl>
  </div>
  <div class="bg-surface p-7">
    <H class="text-xs font-semibold uppercase tracking-[0.22em] text-orange-deep">Adresse</H>
    <p class="mt-3 text-lg font-semibold leading-snug">{site.address.street}<br />{site.address.zip} {site.address.city}</p>
    <a href={site.mapsUrl} rel="noopener" target="_blank" class="mt-4 inline-block text-sm">Route in Google Maps öffnen</a>
  </div>
</div>
