---
import LogoMark from './LogoMark.astro';
import { nav, site } from '../data/site';
interface Props { solid?: boolean }
const { solid = false } = Astro.props;
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
---
<a href="#inhalt" class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-[60] focus:rounded-full focus:bg-ink focus:px-4 focus:py-2 focus:text-ground">Zum Inhalt springen</a>
<header id="site-header" data-solid={solid || undefined} data-scrolled={solid || undefined} class="group fixed inset-x-0 top-0 z-50 transition-[background,box-shadow,color] duration-500 data-[scrolled]:bg-ground/85 data-[scrolled]:shadow-[0_1px_0_#e6ddcd] data-[scrolled]:backdrop-blur-xl">
  <div class="container-page flex h-20 items-center justify-between gap-4 transition-[height] duration-500 group-data-[scrolled]:h-16">
    <a href="/" class="flex items-center gap-3 text-white no-underline group-data-[scrolled]:text-heading" aria-label={`${site.name}, zur Startseite`}>
      <LogoMark class="size-10 shrink-0 drop-shadow" />
      <span class="leading-tight">
        <span class="block text-[1.05rem] font-semibold tracking-tight">{site.shortName}</span>
        <span class="hidden text-xs opacity-75 sm:block">Kinder- und Jugendpsychiater Regensburg</span>
      </span>
    </a>
    <nav aria-label="Hauptnavigation" class="hidden md:block">
      <ul class="flex items-center gap-1 rounded-full bg-white/10 p-1 ring-1 ring-white/20 backdrop-blur-md group-data-[scrolled]:bg-transparent group-data-[scrolled]:ring-0">
        {nav.map((n) => (
          <li><a href={n.href} aria-current={path === n.href ? 'page' : undefined} class="block rounded-full px-4 py-2 text-[0.95rem] font-medium text-white no-underline transition hover:bg-white/15 aria-[current=page]:bg-white aria-[current=page]:text-heading group-data-[scrolled]:text-heading group-data-[scrolled]:hover:bg-sand group-data-[scrolled]:aria-[current=page]:bg-ink group-data-[scrolled]:aria-[current=page]:text-ground">{n.label}</a></li>
        ))}
      </ul>
    </nav>
    <div class="flex items-center gap-2">
      <a href={site.phone.href} class="hidden px-3 py-2 font-medium text-white no-underline lg:inline-flex group-data-[scrolled]:text-heading">{site.phone.display}</a>
      <a href="/kontakt#anmeldung" class="hidden min-h-11 items-center rounded-full bg-orange px-5 font-semibold text-night no-underline transition hover:bg-amber sm:inline-flex">Termin anfragen</a>
      <details class="relative md:hidden">
        <summary class="grid size-11 cursor-pointer list-none place-items-center rounded-full bg-white/15 text-white ring-1 ring-white/30 backdrop-blur group-data-[scrolled]:bg-sand group-data-[scrolled]:text-heading group-data-[scrolled]:ring-0 [&::-webkit-details-marker]:hidden" aria-label="Menü öffnen">
          <svg class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" aria-hidden="true"><path d="M4 8h16M4 16h16" /></svg>
        </summary>
        <nav aria-label="Mobile Navigation" class="absolute right-0 top-14 w-72 rounded-3xl bg-ground p-3 text-heading shadow-2xl ring-1 ring-line">
          <ul>
            {nav.map((n) => (<li><a href={n.href} class="block rounded-2xl px-4 py-3 text-lg font-medium text-heading no-underline hover:bg-sand">{n.label}</a></li>))}
            <li><a href={site.phone.href} class="block rounded-2xl px-4 py-3 font-medium text-heading no-underline hover:bg-sand">Anrufen: {site.phone.display}</a></li>
            <li class="mt-2"><a href="/kontakt#anmeldung" class="block rounded-full bg-orange px-4 py-3 text-center font-semibold text-night no-underline">Termin anfragen</a></li>
          </ul>
        </nav>
      </details>
    </div>
  </div>
</header>
<script>
  const header = document.getElementById('site-header');
  const update = () => header?.toggleAttribute('data-scrolled', header.hasAttribute('data-solid') || window.scrollY > 40);
  update();
  window.addEventListener('scroll', update, { passive: true });
</script>
