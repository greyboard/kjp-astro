---
// Dekorative Logo-Ringe. Rein visuell, für Screenreader ausgeblendet.
interface Props { class?: string; faded?: boolean }
const { class: cls = '', faded = false } = Astro.props;
---
<svg class={cls} viewBox="0 0 400 400" aria-hidden="true" focusable="false">
  <g opacity={faded ? 0.35 : 1}>
    <circle cx="200" cy="200" r="198" fill="#ACC90B" />
    <circle cx="200" cy="200" r="160" fill="#F5E925" />
    <circle cx="200" cy="200" r="124" fill="#FCC016" />
    <circle cx="200" cy="200" r="88" fill="#F07F12" />
    <circle cx="200" cy="200" r="52" fill="#FFFCF6" />
  </g>
</svg>
