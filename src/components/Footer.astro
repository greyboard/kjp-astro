---
import LogoMark from './LogoMark.astro';
import { site, megaMenu } from '../data/site';
const year = new Date().getFullYear();
const [diagnose, therapie] = megaMenu;
const diagnoseLinks = diagnose.columns.flatMap((c) => c.links).slice(0, 6);
const therapieLinks = therapie.columns.flatMap((c) => c.links);
const colors = ['#F07F12', '#FCC016', '#F5E925', '#ACC90B'];
---
<footer class="relative mt-5 bg-night text-white/75">
  <!-- Farbleiste aus den Logo-Ringen -->
  <div class="flex h-1.5" aria-hidden="true">
    {colors.map((c) => <span class="flex-1" style={`background:${c}`}></span>)}
  </div>

  <!-- Kontaktband -->
  <div class="container-page grid gap-6 border-b border-white/10 py-12 md:grid-cols-3 md:items-center">
    <div class="flex items-center gap-4 md:col-span-1">
      <LogoMark class="size-14 shrink-0" />
      <div class="leading-tight">
        <p class="text-lg font-medium text-white">{site.shortName}</p>
        <p class="text-sm text-white/60">{site.tagline}</p>
      </div>
    </div>
    <a href={site.phone.href} class="group flex items-center gap-4 rounded-2xl bg-white/5 p-4 text-white no-underline ring-1 ring-white/10 transition hover:bg-white/10">
      <span class="grid size-12 shrink-0 place-items-center rounded-full bg-orange text-night" aria-hidden="true">
        <svg class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round"><path d="M5 4h4l2 5-2.5 1.5a11 11 0 0 0 5 5L15 13l5 2v4a2 2 0 0 1-2 2A16 16 0 0 1 3 6a2 2 0 0 1 2-2" /></svg>
      </span>
      <span>
        <span class="block text-xl font-medium">{site.phone.display}</span>
        <span class="block text-sm text-white/60">{site.phoneHours}</span>
      </span>
    </a>
    <a href="/kontakt#anmeldung" class="group flex items-center gap-4 rounded-2xl bg-white/5 p-4 text-white no-underline ring-1 ring-white/10 transition hover:bg-white/10">
      <span class="grid size-12 shrink-0 place-items-center rounded-full bg-leaf text-night" aria-hidden="true">
        <svg class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><rect x="3" y="5" width="18" height="16" rx="3" /><path d="M3 10h18M8 3v4M16 3v4" /></svg>
      </span>
      <span>
        <span class="block text-xl font-medium">Ersttermin anfragen</span>
        <span class="block text-sm text-white/60">Formular oder Online-Buchung</span>
      </span>
    </a>
  </div>

  <!-- Linkspalten -->
  <div class="container-page grid gap-10 py-14 sm:grid-cols-2 lg:grid-cols-4">
    <div>
      <p class="footer-title" style="--c:#F07F12">Diagnose</p>
      <ul class="mt-5 space-y-2.5 text-sm">
        {diagnoseLinks.map((l) => <li><a href={l.href} class="footer-link">{l.label}</a></li>)}
        <li><a href={diagnose.cta.href} class="font-semibold text-amber no-underline hover:text-white">{diagnose.cta.label} →</a></li>
      </ul>
    </div>
    <div>
      <p class="footer-title" style="--c:#FCC016">Therapie</p>
      <ul class="mt-5 space-y-2.5 text-sm">
        {therapieLinks.map((l) => <li><a href={l.href} class="footer-link">{l.label}</a></li>)}
      </ul>
    </div>
    <div>
      <p class="footer-title" style="--c:#ACC90B">Praxis</p>
      <address class="mt-5 text-sm not-italic leading-relaxed">
        {site.address.street}<br />{site.address.zip} {site.address.city}<br />
        <a href={site.mapsUrl} target="_blank" rel="noopener" class="footer-link">Route planen</a>
      </address>
      <dl class="mt-5 space-y-2 text-sm">
        {site.openingHours.map((h) => (
          <div><dt class="text-white/50">{h.label}</dt><dd class="text-white">{h.time}</dd></div>
        ))}
      </dl>
      <p class="mt-5 text-sm"><a href={`mailto:${site.email}`} class="footer-link break-all">{site.email}</a></p>
    </div>
    <div>
      <p class="footer-title" style="--c:#F5E925">Service</p>
      <ul class="mt-5 space-y-2.5 text-sm">
        <li><a href="/kontakt#rezept" class="footer-link">Rezept vorbestellen</a></li>
        <li><a href="/kontakt#download" class="footer-link">Unterlagen herunterladen</a></li>
        <li><a href="/kontakt#jugendliche" class="footer-link">Kontakt für Jugendliche</a></li>
        <li><a href="/kontakt#anfahrt" class="footer-link">Anfahrt und Parken</a></li>
      </ul>
      <div class="mt-8 rounded-2xl bg-white/5 p-5 text-sm ring-1 ring-white/10">
        <p class="font-semibold text-white">Im Notfall</p>
        <ul class="mt-3 space-y-1.5">
          <li class="flex justify-between gap-4"><span>Notruf</span><a href="tel:112" class="font-semibold text-white no-underline">112</a></li>
          <li class="flex justify-between gap-4"><span>Bereitschaftsdienst</span><a href="tel:116117" class="font-semibold text-white no-underline">116 117</a></li>
          <li class="flex justify-between gap-4"><span>Nummer gegen Kummer</span><a href="tel:116111" class="font-semibold text-white no-underline">116 111</a></li>
        </ul>
      </div>
    </div>
  </div>

  <!-- Rechtliches -->
  <div class="border-t border-white/10">
    <div class="container-page flex flex-col gap-3 py-6 text-xs text-white/50 sm:flex-row sm:items-center sm:justify-between">
      <p>© {year} {site.name} · ehemals {site.formerName}</p>
      <p class="flex gap-6">
        <a href="/impressum" class="text-white/60 no-underline hover:text-white">Impressum</a>
        <a href="/datenschutzerklaerung" class="text-white/60 no-underline hover:text-white">Datenschutz</a>
      </p>
    </div>
  </div>
</footer>

<style>
  @reference '../styles/global.css';
  .footer-title {
    @apply flex items-center gap-2.5 text-xs font-semibold uppercase tracking-[0.2em] text-white;
  }
  .footer-title::before {
    content: '';
    @apply size-2 rounded-full;
    background: var(--c);
  }
  .footer-link { @apply text-white/75 no-underline transition hover:text-white; }
</style>
