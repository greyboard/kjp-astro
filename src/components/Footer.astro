---
import LogoMark from './LogoMark.astro';
import { site, nav } from '../data/site';
const year = new Date().getFullYear();
---
<footer class="grain relative mt-5 overflow-hidden bg-night text-white/80">
  <div class="container-page grid gap-12 pb-10 pt-20 lg:grid-cols-[1.3fr_1fr_1fr_1fr]">
    <div>
      <LogoMark class="size-14" />
      <p class="mt-6 max-w-sm text-2xl font-semibold leading-tight tracking-tight text-white">Ein Ort des <span class="accent text-amber">Verstehens</span>, seit {site.since} in Regensburg.</p>
      <p class="mt-4 max-w-sm text-sm text-white/60">{site.name}. Ehemals {site.formerName}. {site.tagline}.</p>
    </div>
    <div class="text-sm">
      <p class="text-xs font-semibold uppercase tracking-[0.22em] text-amber">Praxis</p>
      <address class="mt-4 not-italic leading-relaxed">{site.address.street}<br />{site.address.zip} {site.address.city}</address>
      <p class="mt-4 leading-relaxed"><a href={site.phone.href} class="text-white">{site.phone.display}</a><br /><a href={`mailto:${site.email}`} class="break-all text-white">{site.email}</a></p>
    </div>
    <div class="text-sm">
      <p class="text-xs font-semibold uppercase tracking-[0.22em] text-amber">Seiten</p>
      <ul class="mt-4 space-y-2">
        {nav.map((n) => <li><a href={n.href} class="text-white/80 no-underline hover:text-white">{n.label}</a></li>)}
        <li><a href="/kontakt#download" class="text-white/80 no-underline hover:text-white">Unterlagen</a></li>
      </ul>
    </div>
    <div class="text-sm">
      <p class="text-xs font-semibold uppercase tracking-[0.22em] text-amber">Im Notfall</p>
      <p class="mt-4 leading-relaxed">Notruf <a href="tel:112" class="font-semibold text-white">112</a><br />Bereitschaftsdienst <a href="tel:116117" class="font-semibold text-white">116 117</a><br />Nummer gegen Kummer <a href="tel:116111" class="font-semibold text-white">116 111</a></p>
    </div>
  </div>
  <p class="pointer-events-none select-none whitespace-nowrap px-3 text-center text-[13.5vw] font-bold leading-[0.8] tracking-[-0.06em] text-white/[0.06]" aria-hidden="true">Begegnung</p>
  <div class="border-t border-white/10">
    <div class="container-page flex flex-col gap-2 py-6 text-xs text-white/50 sm:flex-row sm:items-center sm:justify-between">
      <p>© {year} {site.name}</p>
      <p class="flex gap-5"><a href="/impressum" class="text-white/60">Impressum</a><a href="/datenschutzerklaerung" class="text-white/60">Datenschutz</a></p>
    </div>
  </div>
</footer>
