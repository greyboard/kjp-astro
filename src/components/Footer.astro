---
import LogoMark from './LogoMark.astro';
import { site } from '../data/site';
const year = new Date().getFullYear();
---
<footer class="mt-24 border-t border-line bg-surface-alt">
  <div class="container-page grid gap-10 py-14 md:grid-cols-[1.4fr_1fr_1fr]">
    <div>
      <div class="flex items-center gap-3">
        <LogoMark class="size-12" />
        <p class="font-display text-lg font-semibold leading-tight">{site.name}</p>
      </div>
      <p class="mt-4 text-sm text-muted">{site.tagline}. Sozialpsychiatrische Praxis in Regensburg seit {site.since}. Ehemals {site.formerName}.</p>
    </div>
    <div class="text-sm">
      <p class="font-bold">Praxis</p>
      <address class="mt-3 not-italic text-muted">{site.address.street}<br />{site.address.zip} {site.address.city}</address>
      <p class="mt-3"><a href={site.phone.href}>{site.phone.display}</a><br /><a href={`mailto:${site.email}`} class="break-all">{site.email}</a></p>
    </div>
    <div class="text-sm">
      <p class="font-bold">Im Notfall</p>
      <p class="mt-3 text-muted">Bei akuter Gefahr: Notruf <a href="tel:112">112</a><br />Ärztlicher Bereitschaftsdienst: <a href="tel:116117">116 117</a><br />Nummer gegen Kummer: <a href="tel:116111">116 111</a></p>
    </div>
  </div>
  <div class="border-t border-line">
    <div class="container-page flex flex-col gap-2 py-6 text-sm text-muted sm:flex-row sm:items-center sm:justify-between">
      <p>© {year} {site.name}</p>
      <p class="flex gap-4"><a href="/impressum" class="text-muted">Impressum</a><a href="/datenschutzerklaerung" class="text-muted">Datenschutz</a></p>
    </div>
  </div>
</footer>
