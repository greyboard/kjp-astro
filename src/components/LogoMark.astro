---
// Bildmarke aus dem Bestandslogo: konzentrische Kreise mit Augen
interface Props { class?: string; title?: string }
const { class: cls = 'size-12', title } = Astro.props;
---
<svg class={cls} viewBox="0 0 120 120" role={title ? 'img' : undefined} aria-hidden={title ? undefined : 'true'} aria-label={title}>
  <circle cx="60" cy="60" r="58" fill="#ACC90B" />
  <circle cx="60" cy="60" r="47" fill="#F5E925" />
  <circle cx="60" cy="60" r="37" fill="#FCC016" />
  <circle cx="60" cy="60" r="27" fill="#F07F12" />
  <circle cx="74" cy="56" r="12" fill="#fff" stroke="#DADADA" stroke-width="2.5" />
  <circle cx="52" cy="56" r="19" fill="#fff" stroke="#DADADA" stroke-width="3" />
  <circle cx="58" cy="57" r="8" fill="#141414" />
  <circle cx="61" cy="53.5" r="2.6" fill="#fff" />
  <circle cx="77" cy="57" r="4.5" fill="#141414" />
  <circle cx="78.5" cy="55" r="1.4" fill="#fff" />
</svg>
