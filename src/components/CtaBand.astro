---
import { Image } from 'astro:assets';
import Button from './Button.astro';
import { site } from '../data/site';
import weg from '../assets/img/weg.jpg';
interface Props { title?: string; accent?: string; text?: string }
const {
  title = 'Sie machen sich Sorgen um Ihr Kind?',
  accent = 'Sprechen Sie uns an.',
  text = 'Gemeinsam klären wir, was Ihr Kind braucht und welcher nächste Schritt sinnvoll ist.',
} = Astro.props;
---
<section class="px-3 sm:px-5">
  <div class="grain relative isolate overflow-hidden rounded-[2.5rem] bg-night text-white">
    <Image src={weg} alt="" widths={[640, 1280]} sizes="100vw" class="absolute inset-0 -z-10 size-full object-cover opacity-70" />
    <div class="absolute inset-0 -z-10 bg-gradient-to-r from-night via-night/70 to-night/10"></div>
    <div class="container-page py-24 sm:py-32" data-reveal>
      <h2 class="max-w-3xl text-4xl text-white sm:text-6xl">{title} <span class="accent text-orange">{accent}</span></h2>
      <p class="mt-6 max-w-xl text-lg text-white/80">{text}</p>
      <div class="mt-10 flex flex-wrap gap-3">
        <Button href="/kontakt#anmeldung">Ersttermin anfragen</Button>
        <Button href={site.phone.href} variant="light">{site.phone.display}</Button>
      </div>
    </div>
  </div>
</section>
